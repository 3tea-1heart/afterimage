{
  "name": "afterimage",
  "productName": "AFTERIMAGE 余像",
  "version": "10.14.0",
  "description": "余像 AFTERIMAGE — 在浏览器与本机运行的图像工坊：风格配方、图层、文字、动态与导出。",
  "license": "MIT",
  "author": "AFTERIMAGE",
  "private": false,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node outputs/local-server.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.afterimage.app",
    "productName": "AFTERIMAGE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "outputs/afterimage-studio/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "outputs/afterimage-studio/dist/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "余像 AFTERIMAGE",
      "artifactName": "Afterimage-${version}-setup.${ext}"
    }
  }
}
